@using PetShop.Models.Entities
@{
    ViewData["Title"] = "Trang chủ - PetShop";
    var products = ViewBag.Products as IEnumerable<Product> ?? new List<Product>();
    var categories = ViewBag.Categories as IEnumerable<Category> ?? new List<Category>();
    var catIcons = new[] { "🐕","🐈","🐠","🐦","🐹","🐰","🦎","🐾" };
}

<!-- HERO -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-lg-7">
                <div class="hero-title">
                    Dinh dưỡng tốt nhất<br/>cho <span>thú cưng</span> của bạn 🐾
                </div>
                <p class="hero-subtitle">
                    Hàng trăm sản phẩm thức ăn cao cấp, phụ kiện và đồ chơi.<br/>
                    Giao hàng nhanh – Chất lượng đảm bảo – Giá tốt nhất.
                </p>
                <div class="d-flex gap-3 flex-wrap">
                    <a asp-controller="Product" asp-action="Index" class="btn btn-primary btn-lg">
                        🛍️ Mua ngay
                    </a>
                    <a asp-controller="Category" asp-action="Index" class="btn btn-outline-light btn-lg"
                       style="border:2px solid rgba(255,255,255,0.3);color:#fff;border-radius:10px;font-weight:700;padding:.65rem 1.5rem;">
                        📂 Xem danh mục
                    </a>
                </div>
                <div class="hero-stats">
                    <div>
                        <div class="hero-stat-num">@products.Count()+</div>
                        <div class="hero-stat-label">Sản phẩm</div>
                    </div>
                    <div>
                        <div class="hero-stat-num">@categories.Count()+</div>
                        <div class="hero-stat-label">Danh mục</div>
                    </div>
                    <div>
                        <div class="hero-stat-num">100%</div>
                        <div class="hero-stat-label">Chất lượng</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-5 text-center d-none d-lg-block">
                <div style="font-size:10rem;line-height:1;filter:drop-shadow(0 20px 40px rgba(0,0,0,0.3));">🐕</div>
            </div>
        </div>
    </div>
</section>

<!-- CATEGORIES -->
@if (categories.Any())
{
<section class="py-5">
    <div class="container">
        <div class="section-header text-center">
            <div class="section-tag">Danh mục</div>
            <h2 class="section-title">Dành cho thú cưng của bạn</h2>
            <p class="section-subtitle">Chọn sản phẩm phù hợp cho từng loài thú cưng</p>
        </div>
        <div class="row g-3 justify-content-center">
            @{ int ci = 0; }
            @foreach (var cat in categories.Take(8))
            {
                <div class="col-6 col-md-4 col-lg-3">
                    <a asp-controller="Product" asp-action="Index" class="cat-card text-decoration-none">
                        <span class="cat-card-icon">@catIcons[ci % catIcons.Length]</span>
                        <div class="cat-card-name">@cat.CategoryName</div>
                        <div class="cat-card-count">@cat.Products.Count sản phẩm</div>
                    </a>
                </div>
                ci++;
            }
        </div>
    </div>
</section>
}

<!-- FEATURED PRODUCTS -->
@if (products.Any())
{
<section class="py-4" style="background: linear-gradient(180deg, #f8f7ff 0%, #fff 100%);">
    <div class="container">
        <div class="section-header d-flex justify-content-between align-items-end">
            <div>
                <div class="section-tag">Nổi bật</div>
                <h2 class="section-title mb-0">Sản phẩm phổ biến</h2>
            </div>
            <a asp-controller="Product" asp-action="Index" class="btn btn-primary">Xem tất cả →</a>
        </div>
        <div class="row g-4">
            @foreach (var p in products.Where(x => x.IsAvailable).Take(8))
            {
                var img = p.ProductImages?.FirstOrDefault(i => i.IsPrimary) ?? p.ProductImages?.FirstOrDefault();
                var emoji = p.Category?.CategoryName?.ToLower().Contains("chó") == true ? "🐕"
                          : p.Category?.CategoryName?.ToLower().Contains("mèo") == true ? "🐈"
                          : p.Category?.CategoryName?.ToLower().Contains("cá") == true ? "🐠" : "🐾";
                var discountedPrice = p.ProductDiscount > 0
                    ? p.ProductPrice * (1 - p.ProductDiscount / 100)
                    : p.ProductPrice;
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="product-card">
                        <div class="product-card-img">
                            @if (img != null)
                            {
                                <img src="@img.ImageUrl" alt="@p.ProductName" style="width:100%;height:100%;object-fit:cover;" />
                            }
                            else
                            {
                                @emoji
                            }
                        </div>
                        <div class="product-card-body">
                            <div class="product-card-category">@(p.Category?.CategoryName ?? "Thú cưng")</div>
                            <div class="product-card-title">@p.ProductName</div>
                            <div class="product-card-desc">@p.ProductDescription</div>
                            <div class="product-card-footer">
                                <div>
                                    <div class="product-price">@discountedPrice.ToString("N0")₫</div>
                                    @if (p.ProductDiscount > 0)
                                    {
                                        <span class="product-price-original">@p.ProductPrice.ToString("N0")₫</span>
                                        <span class="product-discount-badge">-@p.ProductDiscount%</span>
                                    }
                                </div>
                                <a asp-controller="Product" asp-action="Details" asp-route-id="@p.ProductId"
                                   class="btn btn-primary btn-sm">Chi tiết</a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
}

@if (!products.Any())
{
<section class="py-5">
    <div class="container">
        <div class="empty-state">
            <div class="empty-state-icon">🛒</div>
            <h4>Chưa có sản phẩm nào</h4>
            <p>Hãy thêm sản phẩm đầu tiên vào cửa hàng!</p>
            <a asp-controller="Product" asp-action="Create" class="btn btn-primary mt-3">+ Thêm sản phẩm</a>
        </div>
    </div>
</section>
}

<!-- WHY US -->
<section class="py-5">
    <div class="container">
        <div class="section-header text-center">
            <div class="section-tag">Tại sao chọn chúng tôi?</div>
            <h2 class="section-title">Cam kết chất lượng</h2>
        </div>
        <div class="row g-4 text-center">
            <div class="col-md-3">
                <div class="card p-4">
                    <div style="font-size:2.5rem;margin-bottom:.75rem;">🚚</div>
                    <h5 style="font-weight:700;color:var(--dark);">Giao hàng nhanh</h5>
                    <p style="font-size:.88rem;color:var(--text-light);margin:0;">Giao trong 2-4 giờ trong nội thành</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-4">
                    <div style="font-size:2.5rem;margin-bottom:.75rem;">✅</div>
                    <h5 style="font-weight:700;color:var(--dark);">Chất lượng đảm bảo</h5>
                    <p style="font-size:.88rem;color:var(--text-light);margin:0;">Sản phẩm nhập khẩu, có kiểm định</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-4">
                    <div style="font-size:2.5rem;margin-bottom:.75rem;">💰</div>
                    <h5 style="font-weight:700;color:var(--dark);">Giá tốt nhất</h5>
                    <p style="font-size:.88rem;color:var(--text-light);margin:0;">Cam kết hoàn tiền nếu tìm được giá rẻ hơn</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card p-4">
                    <div style="font-size:2.5rem;margin-bottom:.75rem;">💬</div>
                    <h5 style="font-weight:700;color:var(--dark);">Tư vấn 24/7</h5>
                    <p style="font-size:.88rem;color:var(--text-light);margin:0;">Đội ngũ chuyên gia sẵn sàng hỗ trợ</p>
                </div>
            </div>
        </div>
    </div>
</section>
