@model PetShop.Models.Entities.Product
@{
    ViewData["Title"] = "Thêm sản phẩm";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,.7);text-decoration:none;">Trang chủ</a></li><li class="breadcrumb-item"><a asp-action="Index" style="color:rgba(255,255,255,.7);text-decoration:none;">Sản phẩm</a></li><li class="breadcrumb-item active">Thêm mới</li></ol></nav>
        <h1>➕ Thêm sản phẩm mới</h1>
        <p>Điền đầy đủ thông tin để thêm sản phẩm vào cửa hàng</p>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="form-card">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                    <div class="form-group">
                        <label asp-for="ProductName" class="form-label">Tên sản phẩm</label>
                        <input asp-for="ProductName" class="form-control" placeholder="VD: Thức ăn hạt khô cho chó..." />
                        <span asp-validation-for="ProductName" class="text-danger"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="ProductDescription" class="form-label">Mô tả sản phẩm</label>
                        <textarea asp-for="ProductDescription" class="form-control" rows="3" placeholder="Mô tả chi tiết về sản phẩm..."></textarea>
                        <span asp-validation-for="ProductDescription" class="text-danger"></span>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductPrice" class="form-label">Giá (₫)</label>
                                <input asp-for="ProductPrice" class="form-control" placeholder="VD: 150000" />
                                <span asp-validation-for="ProductPrice" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductDiscount" class="form-label">Giảm giá (%)</label>
                                <input asp-for="ProductDiscount" class="form-control" placeholder="VD: 10" />
                                <span asp-validation-for="ProductDiscount" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="ProductQuantity" class="form-label">Số lượng tồn kho</label>
                                <input asp-for="ProductQuantity" class="form-control" placeholder="VD: 50" />
                                <span asp-validation-for="ProductQuantity" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-group">
                                <label asp-for="CategoryId" class="form-label">Danh mục</label>
                                <select asp-for="CategoryId" class="form-control" asp-items="@(ViewBag.Categories as SelectList)">
                                    <option value="">-- Chọn danh mục --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="form-check" style="padding:.75rem 1rem;background:var(--bg);border-radius:8px;border:2px solid var(--border);">
                            <input class="form-check-input" type="checkbox" asp-for="IsAvailable" id="IsAvailable" />
                            <label class="form-check-label fw-bold" for="IsAvailable">
                                ✅ Đang bán (hiển thị trên cửa hàng)
                            </label>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <input type="submit" value="💾 Lưu sản phẩm" class="btn btn-primary flex-fill" />
                        <a asp-action="Index" class="btn btn-secondary">Hủy bỏ</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}