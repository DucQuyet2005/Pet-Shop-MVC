@model PetShop.Models.Entities.Category
@{
    ViewData["Title"] = "Chỉnh sửa danh mục";
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="Index" style="color:rgba(255,255,255,.7);text-decoration:none;">Danh mục</a></li><li class="breadcrumb-item active">Chỉnh sửa</li></ol></nav>
        <h1>✏️ Chỉnh sửa danh mục</h1>
    </div>
</div>

<div class="container pb-5">
    <div class="row justify-content-center">
        <div class="col-lg-5">
            <div class="form-card">
                <div class="text-center mb-4">
                    <div style="font-size:4rem;">📝</div>
                </div>
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="CategoryId" />
                    <div class="form-group">
                        <label asp-for="CategoryName" class="form-label">Tên danh mục</label>
                        <input asp-for="CategoryName" class="form-control" />
                        <span asp-validation-for="CategoryName" class="text-danger"></span>
                    </div>
                    <div class="d-flex gap-3 mt-4">
                        <input type="submit" value="💾 Lưu thay đổi" class="btn btn-primary flex-fill" />
                        <a asp-action="Index" class="btn btn-secondary">Hủy</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
