@model IEnumerable<PetShop.Models.Entities.Category>
@{
    ViewData["Title"] = "Danh mục";
    var catIcons = new[] { "🐕","🐈","🐠","🐦","🐹","🐰","🦎","🐾" };
}

<div class="page-header">
    <div class="container">
        <nav aria-label="breadcrumb"><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" style="color:rgba(255,255,255,.7);text-decoration:none;">Trang chủ</a></li><li class="breadcrumb-item active">Danh mục</li></ol></nav>
        <h1>📂 Quản lý danh mục</h1>
        <p>Tổ chức sản phẩm theo từng loại thú cưng</p>
    </div>
</div>

<div class="container pb-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <span class="fw-bold" style="color:var(--text-light);">@Model.Count() danh mục</span>
        <a asp-action="Create" class="btn btn-primary">+ Thêm danh mục</a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <div class="empty-state-icon">📂</div>
            <h4>Chưa có danh mục nào</h4>
            <p>Hãy tạo danh mục để phân loại sản phẩm</p>
            <a asp-action="Create" class="btn btn-primary mt-3">+ Tạo danh mục</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @{ int i = 0; }
            @foreach (var item in Model)
            {
                <div class="col-sm-6 col-md-4 col-lg-3">
                    <div class="card h-100 text-center p-4" style="position:relative;">
                        <div style="font-size:3.5rem;margin-bottom:.75rem;">@catIcons[i % catIcons.Length]</div>
                        <h5 style="font-weight:800;color:var(--dark);margin-bottom:.35rem;">@item.CategoryName</h5>
                        <p style="font-size:.85rem;color:var(--text-light);margin-bottom:1.25rem;">
                            @item.Products.Count sản phẩm
                        </p>
                        <div class="d-flex gap-2 justify-content-center">
                            <a asp-action="Details" asp-route-id="@item.CategoryId" class="btn btn-info btn-sm">Chi tiết</a>
                            <a asp-action="Edit" asp-route-id="@item.CategoryId" class="btn btn-warning btn-sm">Sửa</a>
                            <a asp-action="Delete" asp-route-id="@item.CategoryId" class="btn btn-danger btn-sm">🗑</a>
                        </div>
                    </div>
                </div>
                i++;
            }
        </div>
    }
</div>
